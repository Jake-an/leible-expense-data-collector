node_modules/

# Share team-facing Claude config (settings, hooks, commands); ignore everything
# else under .claude/ (memory, personal state, credentials).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/

.env
.env.local
credentials/
*.credentials.json
secrets/

# Downloaded business data — never commit PII or financials
downloads/
*.csv
*.xlsx
*.pdf

# Playwright saved sessions (contain auth cookies)
sessions/

# Harness phase execution outputs (contain stdout/stderr dumps)
phases/**/step*-output.json
phases/**/phase*-output.json

# clasp config (transient, per-env)
.clasp.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
logs/
