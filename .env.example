# .env.example — copy to .env and fill in real values. (.env is gitignored.)
# Credentials power connector auto-login: a headless form-fill re-auths when a
# saved portal session dies, so no more manual --attended runs. No values here.

# GAS web-app /exec URL. Optional — normally resolved from config/deployment.json;
# set only to override.
GAS_EXEC_URL=

# Ordermentum — ONE login covers all venues. Plain email+password, no MFA/CAPTCHA.
ORDERMENTUM_EMAIL=
ORDERMENTUM_PASSWORD=

# Fresh & Chill (Zupply Chef) — ONE account PER shop (4 separate logins).
FRESH_AND_CHILL_YORK_EMAIL=
FRESH_AND_CHILL_YORK_PASSWORD=
FRESH_AND_CHILL_NORTH_EMAIL=
FRESH_AND_CHILL_NORTH_PASSWORD=
FRESH_AND_CHILL_CROWSNEST_EMAIL=
FRESH_AND_CHILL_CROWSNEST_PASSWORD=
FRESH_AND_CHILL_PITT_EMAIL=
FRESH_AND_CHILL_PITT_PASSWORD=
